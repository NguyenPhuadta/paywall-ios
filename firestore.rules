rules_version = '2';
// comments/{paywall}/entries/{id}: text, rect, context, timestamps, immutable owner.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function valid(d) {
      return d.keys().hasAll(['text','rect','context','createdAt','updatedAt','owner'])
        && d.keys().hasOnly(['text','rect','context','createdAt','updatedAt','owner'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 4000
        && d.owner is string && d.owner.size() <= 128
        && d.createdAt is string && d.createdAt.size() <= 30
        && d.updatedAt is string && d.updatedAt.size() <= 30
        && d.rect is map && d.rect.keys().hasOnly(['x','y','w','h']) && d.rect.keys().hasAll(['x','y','w','h'])
        && d.rect.x is number && d.rect.x >= 0 && d.rect.x <= 1
        && d.rect.y is number && d.rect.y >= 0 && d.rect.y <= 1
        && d.rect.w is number && d.rect.w >= 0 && d.rect.w <= 1
        && d.rect.h is number && d.rect.h >= 0 && d.rect.h <= 1
        && d.context is map && d.context.keys().hasOnly(['lang','device','eligibility','state']) && d.context.keys().hasAll(['lang','device','eligibility','state'])
        && d.context.lang is string && d.context.lang.size() <= 32
        && d.context.device is string && d.context.device.size() <= 32
        && d.context.eligibility is string && d.context.eligibility.size() <= 32
        && d.context.state is string && d.context.state.size() <= 64;
    }
    match /comments/{paywall}/entries/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && valid(request.resource.data) && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && valid(request.resource.data) && request.resource.data.owner == resource.data.owner && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
